# ═══════════════════════════════════════════════════════════════
# CONFIGURATION DU BOT TELEGRAM SHADYBOT 
# ═══════════════════════════════════════════════════════════════

# Token du bot (obtenu sur @BotFather)
BOT_TOKEN=

# IDs des administrateurs (séparés par des virgules)
ADMIN_IDS=

# Base de données SQLite
DATABASE_PATH=bot_data.db

# Paramètres de modération
MAX_WARNINGS=3
MUTE_DURATION=3600

# Paramètres de diffusion
BROADCAST_DELAY=0.5

# Paramètres de recherche web
SEARCH_TIMEOUT=15
MAX_SEARCH_RESULTS=5

# Niveau de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dossier de sauvegarde
BACKUP_DIR=backups

AI_MODEL=openrouter/free
AI_TEMPERATURE=0.7
AI_MAX_HISTORY_MESSAGES=12
AI_GROUP_MENTION_ONLY=true

